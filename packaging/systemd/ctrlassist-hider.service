[Unit]
Description=CtrlAssist hiding service
Documentation=https://github.com/CtrlAssist/CtrlAssist
Requires=ctrlassist-hider.socket

[Service]
ExecStart=/usr/bin/ctrlassist-hider
# Whatever is still hidden when the service stops, for any reason, is put
# back.
ExecStopPost=/usr/bin/ctrlassist-hider reconcile

# It must write udev rules under /run, re-bind drivers under /sys and
# change device nodes, as root. Everything else is closed off. The network
# namespace is left shared: udev's events arrive over a netlink socket
# that a private one wouldn't receive.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN

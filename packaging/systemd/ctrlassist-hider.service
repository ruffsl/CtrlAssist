[Unit]
Description=CtrlAssist hiding service
Documentation=https://github.com/CtrlAssist/CtrlAssist
Requires=ctrlassist-hider.socket
# It exits when its last client has gone and is started again by the
# next, so how often it starts is its clients' doing: a few short-lived
# ones in a row must not leave it refused, and hiding with it.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/ctrlassist-hider
# Whatever is still hidden when the service stops, for any reason, is put
# back.
ExecStopPost=/usr/bin/ctrlassist-hider reconcile

# A user of its own, with no capabilities. Its power is what the shipped
# udev rule (72-ctrlassist-hide.rules) gives its group: the nodes of pads
# it has hidden, PlayStation pads' raw nodes, and the uevent files of
# pads' devices, through which it asks udev to re-bind a driver.
User=ctrlassist-hider
Group=ctrlassist-hider
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

# Anyone may connect, and each connection is a descriptor and a thread.
# The service caps them: 40 for a user logged in at a seat, whose daemon
# holds two for each pad it is hiding; and eight for any other user, with
# 32 between all of them. A connection's thread holds at most six
# descriptors at once, so this is room for some thirty users at seats,
# each with their cap full.
LimitNOFILE=8192

# The markers the rule hides pads by. Kept when the service stops, so
# that what a service that died left hidden is still named when
# ExecStopPost puts it back; /run is emptied at boot.
RuntimeDirectory=ctrlassist/hide
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077

# Everything else is closed off, as defense in depth: the user's own
# permissions are the boundary. /run and /sys are named read-only as well
# as protected, since on systemd 262 the protections below leave both
# writable under ProtectSystem=strict; under /sys only the devices, whose
# uevent files the rule gives the group, are writable. The network
# namespace is left shared: udev's events arrive over netlink in the
# host's.
ProtectSystem=strict
ReadOnlyPaths=/run
BindReadOnlyPaths=/sys
ReadWritePaths=/sys/devices
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
RemoveIPC=yes
DevicePolicy=closed
DeviceAllow=char-input rw
DeviceAllow=char-hidraw rw
# Its listener comes from systemd and its connections from accept: the
# one socket it makes is udev's monitor.
RestrictAddressFamilies=AF_NETLINK
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

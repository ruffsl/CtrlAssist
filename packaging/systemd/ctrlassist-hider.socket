[Unit]
Description=CtrlAssist hiding service socket
Documentation=https://github.com/CtrlAssist/CtrlAssist

[Socket]
ListenSequentialPacket=/run/ctrlassist/hider.sock
# Anyone may connect; the service serves only the user whose session is in
# front on a seat, and checks that itself on each connection.
SocketMode=0666
DirectoryMode=0755
# No connection passes a descriptor until the service has admitted it,
# within its caps, so one it won't serve carries nothing whose release
# could block it. Set here, not only by the service: a connection queued
# before the service starts has the listener's setting from when it
# connected. Needs Linux 6.16 and systemd 258; an older systemd ignores
# the line, and the service then sets it itself as it starts, and an
# older kernel has no such setting, which the service says.
AcceptFileDescriptors=no
# The limits on how often the socket starts the service are systemd's
# own: the service stays once started, so they are reached only by a
# start that keeps failing, which they stop.

[Install]
WantedBy=sockets.target

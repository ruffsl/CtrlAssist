[Unit]
Description=CtrlAssist daemon
Documentation=https://github.com/CtrlAssist/CtrlAssist

[Service]
Type=simple
ExecStart=/usr/bin/ctrlassist service daemon
SyslogIdentifier=ctrlassist-daemon
Restart=on-failure
RestartSec=5
# The input thread asks for real-time scheduling at priority 10 and runs
# without it if refused. Nothing here can grant that: a user service has
# the limit its user's service manager has, which the package raises with
# a drop-in on user@.service.

[Install]
WantedBy=default.target

# The CtrlAssist hiding service's rule. The service runs as the user and
# group ctrlassist-hider, with no capabilities; what it may do is what
# this rule gives that group:
#
# - ask udev to re-bind a pad's driver, which cuts off whatever had the
#   pad open, through the uevent file of the pad's HID device or USB
#   interface, which only pads have given to the group;
# - open the raw node of a PlayStation pad;
# - have a pad hidden, by creating a marker file named after it in
#   /run/ctrlassist/hide: its nodes then go to the group alone, and lose
#   seat access, at the pad's next event.
#
# This file never changes and udev is never asked to reload it: the
# markers are tested at each event.
#
# It must sort after 70-uaccess.rules, which tags pads for seat access,
# and after any 60-*.rules that opens hidraw, as Steam's does; and before
# 73-seat-late.rules, which grants the access the tag asks for.

ACTION=="remove", GOTO="ctrlassist_hide_end"

# The re-bind: a change event the service sends a pad's device, marked
# with its own argument. The probe, not a bind to the same driver, so
# whichever driver a plug-in would bind takes the pad again.
SUBSYSTEM=="hid|usb", ACTION=="change", ENV{SYNTH_ARG_CTRLASSIST}=="rebind", \
  ATTR{driver/unbind}="%k", ATTR{subsystem/drivers_probe}="%k", GOTO="ctrlassist_hide_end"

SUBSYSTEM=="hidraw", GOTO="ctrlassist_hide_hidraw"
SUBSYSTEM!="input", GOTO="ctrlassist_hide_end"
KERNEL!="event*|js*", GOTO="ctrlassist_hide_end"
ENV{ID_INPUT_JOYSTICK}!="1", GOTO="ctrlassist_hide_end"

# Which devices the service may ask to re-bind: the HID device, or with
# none the USB interface, of a joystick that nothing a keystroke or a
# pointer could come from shares, as the service itself checks. sysfs
# keeps the file's group and mode for as long as the device exists,
# which a re-bind of its driver doesn't end.
KERNEL!="event*", GOTO="ctrlassist_hide_markers"
ENV{ID_INPUT_KEYBOARD}=="1", GOTO="ctrlassist_hide_markers"
ENV{ID_INPUT_KEY}=="1", GOTO="ctrlassist_hide_markers"
ENV{ID_INPUT_MOUSE}=="1", GOTO="ctrlassist_hide_markers"
ENV{ID_INPUT_TOUCHPAD}=="1", GOTO="ctrlassist_hide_markers"
ENV{ID_INPUT_TABLET}=="1", GOTO="ctrlassist_hide_markers"
SUBSYSTEMS=="hid", DRIVERS=="?*", \
  RUN+="/usr/bin/chgrp ctrlassist-hider /sys/bus/hid/devices/%b/uevent", \
  RUN+="/usr/bin/chmod g+w /sys/bus/hid/devices/%b/uevent", GOTO="ctrlassist_hide_markers"
SUBSYSTEMS=="usb", DRIVERS=="?*", \
  RUN+="/usr/bin/chgrp ctrlassist-hider /sys/bus/usb/devices/%b/uevent", \
  RUN+="/usr/bin/chmod g+w /sys/bus/usb/devices/%b/uevent"

# Event and js nodes: by the pad's address, by its USB serial number, by
# its HID device, or by its USB port. The attributes are the input
# device's, the parent each line's ATTRS match selected. A marker's name
# has a prefix, so a value that is empty, or carries "/" or "..", names a
# file that doesn't exist.
LABEL="ctrlassist_hide_markers"
ATTRS{uniq}=="?*", TEST=="/run/ctrlassist/hide/addr-%s{uniq}", GOTO="ctrlassist_hide"
ENV{ID_SERIAL_SHORT}=="?*", ATTRS{id/vendor}=="?*", TEST=="/run/ctrlassist/hide/serial-%s{id/vendor}-%s{id/product}-$env{ID_SERIAL_SHORT}", GOTO="ctrlassist_hide"
SUBSYSTEMS=="hid", TEST=="/run/ctrlassist/hide/hid-%b", GOTO="ctrlassist_hide"
ATTRS{phys}=="usb-?*", TEST=="/run/ctrlassist/hide/port-%s{phys}", GOTO="ctrlassist_hide"
GOTO="ctrlassist_hide_end"

# Hidraw nodes: by their HID device, by its own unique string (an
# address on Bluetooth, set as the device is made), or by its USB port.
# The imports have lines of their own: udev compares a line's ENV keys
# before it runs the line's imports.
LABEL="ctrlassist_hide_hidraw"
# The raw node of a pad whose raw node the service opens unhidden, for
# the DualSense identity's copy: the group's, beside whatever seat access
# it has.
DRIVERS=="playstation", GROUP="ctrlassist-hider", MODE="0660"
SUBSYSTEMS=="hid", TEST=="/run/ctrlassist/hide/hid-%b", GOTO="ctrlassist_hide"
IMPORT{parent}="HID_UNIQ"
IMPORT{parent}="HID_ID"
IMPORT{parent}="HID_PHYS"
ENV{HID_UNIQ}=="?*", ENV{HID_ID}=="?*", TEST=="/run/ctrlassist/hide/uniq-$env{HID_ID}-$env{HID_UNIQ}", GOTO="ctrlassist_hide"
ENV{HID_PHYS}=="usb-?*", TEST=="/run/ctrlassist/hide/port-$env{HID_PHYS}", GOTO="ctrlassist_hide"
GOTO="ctrlassist_hide_end"

# Hidden: the group's alone, with no seat access. Final, so that a later
# rule can't open the node again. A node made by a re-bind has no ACL
# for the tag's removal to leave behind.
LABEL="ctrlassist_hide"
OWNER:="root", GROUP:="ctrlassist-hider", MODE:="0660", TAG-="uaccess"

LABEL="ctrlassist_hide_end"

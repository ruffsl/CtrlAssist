### 3. Clean Up mux2 Module

#### [DELETE] [src/mux2/runtime.rs](file:///home/ruffsl/git/ruffsl/CtrlAssist/src/mux2/runtime.rs) - Remove shim runtime

The entire [run_input_loop](file:///home/ruffsl/git/ruffsl/CtrlAssist/src/demux/runtime.rs#78-132) and [run_ff_loop](file:///home/ruffsl/git/ruffsl/CtrlAssist/src/demux/runtime.rs#133-218) functions are replaced by GraphExecutor.

#### [REWRITE] [src/mux2/manager.rs](file:///home/ruffsl/git/ruffsl/CtrlAssist/src/mux2/manager.rs) - Use GraphExecutor

```rust
pub fn start_mux2(...) -> Result<Mux2Handle, ...> {
    // Create nodes
    let source_primary = SourceNode::new(gilrs, primary_id);
    let source_assist = SourceNode::new(gilrs, assist_id);
    let mux = MuxNode::new(mode);
    let sink = SinkNode::new(virtual_device);
    
    // Build graph
    let mut graph = Graph::new();
    let primary_id = graph.add_node(source_primary);
    let assist_id = graph.add_node(source_assist);
    let mux_id = graph.add_node(mux);
    let sink_id = graph.add_node(sink);
    
    // Connect edges (input direction)
    graph.connect(primary_id, ports::SOURCE_OUTPUT, mux_id, ports::MUX_PRIMARY_IN);
    graph.connect(assist_id, ports::SOURCE_OUTPUT, mux_id, ports::MUX_ASSIST_IN);
    graph.connect(mux_id, ports::MUX_OUTPUT, sink_id, ports::SINK_INPUT);
    
    // Connect edges (FF direction - reversed)
    graph.connect(sink_id, ports::SINK_FF_OUT, mux_id, ports::MUX_FF_IN);
    graph.connect(mux_id, ports::MUX_PRIMARY_IN, primary_id, ports::SOURCE_FF_IN);
    graph.connect(mux_id, ports::MUX_ASSIST_IN, assist_id, ports::SOURCE_FF_IN);
    
    // Create executor and run
    let executor = GraphExecutor::new(graph);
    
    // Single thread with tick loop
    thread::spawn(move || {
        while !shutdown.load(Ordering::Relaxed) {
            executor.tick_all();  // Polls sources, processes, forwards FF
            thread::sleep(Duration::from_micros(500));
        }
    });
}
```


# Generated by Cargo
target

# Coverage report written by `just test-ci`
/lcov.info

# Direnv
.direnv/
# Host/session-specific direnv overrides
.envrc.local

# Nix build output symlink
result

# The attribution bundle, generated by `just licenses-html` for the
# packages
/packaging/licensing/THIRD-PARTY-LICENSES.html

# The user guide as built by `just docs-build`; its source is
# docs/book/src
/docs/book/book/

# mdbook-mermaid's assets, made again by `mdbook-mermaid install docs/book`
# (`just docs-build`, CI and Read the Docs). mermaid.min.js is a bundle of
# some megabytes; it stays out of git.
/docs/book/mermaid.min.js
/docs/book/mermaid-init.js

# Shell-completion registrations, generated by `just completions` for
# the packages
/packaging/completions/

# Worktrees that Claude Code makes for its agents.
/.claude/worktrees/

# cargo-cyclonedx output: `just sbom` moves the shipped binaries' SBOMs
# to target/sbom/ and deletes the rest, but an interrupted run leaves them.
/crates/*/*.cdx.json

// The Profiles pane's model and callbacks. Rust pushes `rows` from the
// daemon's mirror, the fields the daemon serves for a preset, and the
// edits the window is holding that aren't a profile yet.

// One field of a preset's form, with what it holds now. Which control
// shows it goes by `kind`: "choice", "pad", "number" or "switch".
export struct ProfileFieldRow {
    key: string,
    label: string,
    help: string,
    kind: string,
    // A choice's or a pad's options as a person reads them, and, place
    // for place, as a profile writes them.
    options: [string],
    option-values: [string],
    // What it holds, as a profile writes it, and as a person reads it.
    value: string,
    value-label: string,
    // The chosen choice's sentence; empty when it has none.
    description: string,
    // A pad the form can't pick (any pad of a model, or one the daemon
    // has never seen): shown, not changed.
    read-only: bool,
    // For a number: what it is, and its range.
    number: int,
    min: int,
    max: int,
    // For a switch.
    checked: bool,
    // What leaving the field out means, as a profile writes it; empty
    // for a field that must be given, which has nothing to go back to.
    default-value: string,
    // The field stands at its default.
    at-default: bool,
    // The card it is shown in: "inputs", "outputs", or anything else
    // for the preset's own.
    group: string,
    // For a pad: the id of the known pad chosen, for the row's pencil,
    // empty when none is; and that pad's connection, in a word and the
    // word's tone.
    pad: string,
    status-word: string,
    status-tone: string,
}

// A virtual pad of a profile: its name there, what it presents itself
// as, and where it is while the profile runs.
export struct ProfileOutputRow {
    name: string,
    identity: string,
    node: string,
    // Its id among the Pads pane's rows while it exists, for the row's
    // pencil; empty while it doesn't.
    pad: string,
    // Whether it exists, in a word and the word's tone.
    word: string,
    tone: string,
}

// A pad a profile names, for its header's links.
export struct ProfileUseRow {
    // The part it plays: "Primary", "Assist", "Pad".
    part: string,
    // The pad's id, for the link; empty for one the daemon doesn't
    // know, which has nowhere to go.
    pad: string,
    // The pad's name, or what the profile calls it.
    name: string,
    // Its connection, in a word and the word's tone.
    word: string,
    tone: string,
}

export struct ProfileRow {
    name: string,
    // "preset": the form shows it. "full": it is written by hand, and
    // the window shows none of it. "gone": only its setup is left, the
    // profile deleted or its file removed, and the row is there so the
    // setup can be stopped.
    kind: string,
    // Its arrangement's shape, for its tile: "merge", "split", or
    // empty for neither.
    shape: string,
    // How it is, in a word, and the word's tone: Running, Held, Failed,
    // Ready, Waiting, Unfinished, Wrong.
    word: string,
    word-tone: string,
    // A line of how it is, beside its Start or Stop.
    note: string,
    // Its mode as a person reads it, for its header: "Toggle", or
    // "Written by hand" for one that is; empty while it has none.
    mode-label: string,
    // The daemon starts it whenever its pads are connected.
    managed: bool,
    // It can be started now, as far as the window can tell.
    can-start: bool,
    // Where its setup is among `Setups.rows`; -1 for none.
    setup-index: int,
    // The pads it names.
    uses: [ProfileUseRow],
    // Its virtual pads.
    outputs: [ProfileOutputRow],
    // The window holds changes to it that aren't a profile the daemon
    // would keep yet; `unfinished-why` says what is missing. A profile
    // that isn't kept at all yet is one of these.
    unfinished: bool,
    unfinished-why: string,
    kept: bool,
    // What the daemon finds wrong with the kept text; empty for none.
    problem: string,
    // A line for the list: the preset and identity, or "full form".
    summary: string,
    // Its setup, if one exists: the phase as read, and the chip's tone.
    running: bool,
    phase-label: string,
    tone: string,
    // The default profile: always kept, listed first, never renamed or
    // deleted.
    is-default: bool,
    // A preset's fields, all of them and then by the card each is
    // shown in.
    fields: [ProfileFieldRow],
    input-fields: [ProfileFieldRow],
    // Those of the outputs but the identity, which the first virtual
    // pad's row carries; its `key` is empty for a profile with none.
    output-fields: [ProfileFieldRow],
    identity-field: ProfileFieldRow,
    preset-fields: [ProfileFieldRow],
}

export global Profiles {
    in property <[ProfileRow]> rows;
    // How many of `rows` have a setup; they come first.
    in property <int> running-count;
    in-out property <int> selected-index: -1;

    // A field was set: profile, key, value as a profile writes it.
    callback set-field(string, string, string);
    callback set-number(string, string, int);
    callback start(string);
    callback delete(string);
    // Drop the changes the window holds for it.
    callback discard(string);
    // A new one of that name; a copy of the first under the second; the
    // first renamed to the second.
    callback create(string);
    callback duplicate(string, string);
    callback rename(string, string);
    // What is wrong with a name for a new profile; empty for a good one.
    pure callback name-problem(string) -> string;
    // Whether the window holds a change to it that isn't a profile yet.
    pure callback unfinished(string) -> bool;
    // Select the profile of that name.
    callback select(string);
    // Show its file in the file manager.
    callback reveal(string);
    // Put a field back to its default: the profile, the field's key.
    callback reset-field(string, string);
    // Show a pad in the Pads pane.
    callback open-pad(string);
}

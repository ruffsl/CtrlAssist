// The Setups pane: the setups that exist (starting, running, held or
// failed), and for the one selected its pads by role, its virtual pads,
// what its nodes select, and what to do with it: stop it, update it to
// its profile as kept now, hand a selection to another.
//
// The list and the detail are the shapes of the Pads pane's, and so of
// TisVlay's TVs pane, and take part in key navigation the same way.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Design } from "../design.slint";
import { ListRow, Group, Chip, ThemedButton, DangerBtn, LinkText, ConfirmDialog, InlineError } from "../widgets.slint";
import { HelpScrollView } from "../globals/help.slint";
import { ServiceHealth } from "../globals/health.slint";
import { Errors } from "../globals/errors.slint";
import { Nav } from "../globals/nav.slint";
import { Setups, SetupRow, SetupPadRow, SetupSinkRow, SetupNodeRow } from "../globals/setups.slint";

component SetupListRow inherits ListRow {
    in property <SetupRow> setup;

    accessible-label: root.setup.name;
    accessible-id: "setups-row-" + root.setup.name;
    height: 64px;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: 12px;
        alignment: start;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.setup.name;
                color: root.title-color;
                font-size: Design.font-body;
                font-weight: root.title-weight;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: Design.gap-tight;
                alignment: start;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: Design.size-status-dot;
                    height: Design.size-status-dot;
                    border-radius: 3px;
                    background: root.setup.tone == "success" ? Theme.success
                        : root.setup.tone == "warn" ? Theme.warn
                        : root.setup.tone == "danger" ? Theme.danger
                        : Theme.text-faint;
                }
                Text {
                    text: root.setup.phase-label;
                    color: root.setup.tone == "success" ? Theme.success-text
                        : root.setup.tone == "warn" ? Theme.warn-text
                        : root.setup.tone == "danger" ? Theme.danger-text
                        : Theme.text-faint;
                    font-size: Design.font-mini;
                }
                if root.setup.stale: Text {
                    text: @tr("profile changed");
                    color: Theme.warn-text;
                    font-size: Design.font-mini;
                }
            }
        }
    }
}

component SetupList inherits Rectangle {
    in property <bool> daemon-available;
    in property <bool> daemon-loading;
    in property <ServiceHealth> daemon-health;
    callback activated();

    // As the Pads pane's list: a column request lands on the selected
    // row, else the first; with no rows, on the link to the Profiles
    // pane when there is one, else back at the sidebar.
    property <string> focus-row-name;
    property <int> focus-row-tick;
    property <int> column-mirror: Nav.column-tick;
    changed column-mirror => {
        root.serve-column-request();
    }
    property <bool> has-selection: Setups.selected-index >= 0 && Setups.selected-index < Setups.rows.length;

    function focus-slot(slot: int) {
        if (slot >= 0 && slot < Setups.rows.length) {
            root.focus-row-name = Setups.rows[slot].name;
            root.focus-row-tick += 1;
        }
    }
    init => {
        if (Nav.column-tick != Nav.column-served) {
            serve-later.running = true;
        }
    }
    serve-later := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.serve-column-request();
        }
    }
    function serve-column-request() {
        if (Nav.column-target == 1 || (Nav.column-target == 2 && !root.has-selection)) {
            Nav.column-served = Nav.column-tick;
            if (Setups.rows.length > 0) {
                root.focus-row-name = Setups.rows[root.has-selection ? Setups.selected-index : 0].name;
                root.focus-row-tick += 1;
            } else {
                Nav.request-column(0);
            }
        }
    }

    width: Design.width-master + 60px;
    background: Theme.surface-alt;

    Rectangle {
        x: parent.width - 1px;
        width: Design.border-thin;
        background: Theme.border;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;

        Rectangle {
            height: 40px;
            background: Theme.surface;
            Rectangle {
                x: parent.width - 1px;
                width: Design.border-thin;
                background: Theme.border;
            }
            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding-left: 12px;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: @tr("SETUPS · {}", Setups.rows.length);
                        color: Theme.text-dim;
                        font-size: Design.font-mini;
                        font-weight: 600;
                        letter-spacing: 0.6px;
                    }
                }
            }
        }

        if Setups.rows.length == 0: Rectangle {
            VerticalLayout {
                width: 100%;
                alignment: center;
                padding: Design.gap-pane;
                Text {
                    text: !root.daemon-available ? @tr("Daemon offline")
                        : root.daemon-health == ServiceHealth.incompatible ? @tr("Setups hidden: version mismatch")
                        : root.daemon-loading ? @tr("Loading")
                        : @tr("No setup is running.");
                    color: !root.daemon-available || root.daemon-health == ServiceHealth.incompatible
                        ? Theme.danger-text : Theme.text-faint;
                    font-size: Design.font-body;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    accessible-id: "setups-empty";
                }
            }
        }

        ScrollView {
            content-width: self.visible-width;
            VerticalLayout {
                alignment: start;
                for setup[i] in Setups.rows: SetupListRow {
                    setup: setup;
                    selected: i == Setups.selected-index;
                    tab-stop: root.has-selection ? i == Setups.selected-index : i == 0;
                    focus-tick: root.focus-row-tick;
                    focus-wanted: setup.name == root.focus-row-name;
                    focus-in => {
                        Setups.selected-index = i;
                    }
                    clicked => {
                        Setups.selected-index = i;
                        root.activated();
                    }
                    step(forward) => {
                        Nav.list-step-served = Nav.list-step-tick;
                        root.focus-slot(forward ? i + 1 : i - 1);
                    }
                }
            }
        }
    }
}

// One pad of the setup: its role, the pad as a link to it, and whether
// it is there.
component PadOfSetup {
    in property <SetupPadRow> pad;
    in property <string> id-prefix;
    property <int> row-id;
    init => {
        root.row-id = Nav.next-row-id();
    }

    HorizontalLayout {
        width: 100%;
        spacing: Design.gap-stack;
        padding-top: Design.gap-form;
        padding-bottom: Design.gap-form;

        VerticalLayout {
            width: Design.width-label-col + 20px;
            alignment: center;
            Text {
                text: root.pad.role;
                color: Theme.text-dim;
                font-size: Design.font-meta;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            if root.pad.pad == "": Text {
                text: @tr("Waiting for a pad that fits");
                color: Theme.text-faint;
                font-size: Design.font-meta;
            }
            // A pad's name can be longer than the row: the link is cut
            // at the row's edge and doesn't push the chip off it. A
            // plain Rectangle, since a layout would hand the link's
            // whole width on as the row's least.
            if root.pad.pad != "": Rectangle {
                clip: true;
                height: link.height;
                link := LinkText {
                    x: 0;
                    nav-row: root.row-id;
                    text: root.pad.name;
                    font-size: Design.font-meta;
                    tip: @tr("Show this pad");
                    accessible-id: root.id-prefix + "setups-pad-" + root.pad.role;
                    clicked => { Setups.open-pad(root.pad.pad); }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Chip {
                label: root.pad.present ? @tr("there") : @tr("missing");
                tone: root.pad.present ? "success" : "warn";
            }
        }
    }
}

// One node that selects: its name, and a button for each choice, the
// selected one marked.
component NodeOfSetup {
    in property <string> setup;
    in property <string> id-prefix;
    in property <SetupNodeRow> node;
    in property <bool> enabled;
    property <int> row-id;
    init => {
        root.row-id = Nav.next-row-id();
    }

    HorizontalLayout {
        width: 100%;
        spacing: Design.gap-stack;
        padding-top: Design.gap-form;
        padding-bottom: Design.gap-form;

        VerticalLayout {
            width: Design.width-label-col + 20px;
            alignment: center;
            Text {
                text: root.node.name;
                color: Theme.text-dim;
                font-size: Design.font-meta;
            }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: Design.gap-tight;
            for choice[i] in root.node.choices: ThemedButton {
                nav-row: root.row-id;
                text: choice;
                primary: i == root.node.selected;
                enabled: root.enabled;
                accessible-id: root.id-prefix + "setups-node-" + root.node.name + "-" + choice;
                clicked => { Setups.select(root.setup, root.node.name, choice); }
            }
        }
    }
}

component SetupDetail inherits Rectangle {
    in property <SetupRow> setup;
    // Every setup has a detail and one shows. The hidden ones' controls
    // go by other ids, so a request to put focus back on a control by
    // its id finds the one on screen.
    property <string> id-prefix: root.visible ? "" : "hidden-";
    in property <bool> daemon-available;
    callback request-stop();

    in property <int> focus-tick;
    changed focus-tick => {
        if (root.visible) {
            stop.focus();
        }
    }
    property <int> header-row;
    init => {
        root.header-row = Nav.next-row-id();
    }

    background: Theme.surface-alt;

    HelpScrollView {
        VerticalLayout {
            width: 100%;
            padding-left: Design.pad-pane;
            padding-right: Design.pad-pane;
            padding-top: Design.pad-header-top;
            padding-bottom: Design.pad-pane;
            spacing: Design.gap-pane;
            alignment: start;

            VerticalLayout {
                spacing: Design.gap-block;
                VerticalLayout {
                    spacing: Design.gap-stack;
                    Text {
                        text: root.setup.name;
                        color: Theme.text;
                        font-size: Design.font-title-3;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Design.gap-tight;
                        Chip {
                            label: root.setup.phase-label;
                            tone: root.setup.tone;
                        }
                        if root.setup.stale: Chip {
                            label: root.setup.profile-kept ? @tr("Profile changed") : @tr("Profile gone");
                            tone: "warn";
                            tip: root.setup.profile-kept
                                ? @tr("The profile as kept now is another than this setup runs. Update applies it.")
                                : @tr("The profile this setup runs is no longer kept. It runs it as it was.");
                        }
                    }
                    if root.setup.reason != "": Text {
                        text: root.setup.reason;
                        color: Theme.danger-text;
                        font-size: Design.font-meta;
                        wrap: word-wrap;
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Design.gap-stack;
                    stop := DangerBtn {
                        nav-row: root.header-row;
                        text: @tr("Stop");
                        enabled: root.daemon-available;
                        accessible-id: root.id-prefix + "setups-stop";
                        clicked => { root.request-stop(); }
                    }
                    ThemedButton {
                        nav-row: root.header-row;
                        text: @tr("Update…");
                        // Something to apply, and a profile to apply.
                        enabled: root.daemon-available && root.setup.stale && root.setup.profile-kept;
                        accessible-id: root.id-prefix + "setups-update";
                        clicked => { Setups.ask-update(root.setup.name); }
                    }
                    if root.setup.profile-kept: VerticalLayout {
                        alignment: center;
                        LinkText {
                            nav-row: root.header-row;
                            text: @tr("Its profile");
                            font-size: Design.font-meta;
                            tip: @tr("Show the profile this setup runs");
                            accessible-id: root.id-prefix + "setups-profile-link";
                            clicked => { Setups.open-profile(root.setup.name); }
                        }
                    }
                }
            }

            Group {
                title: @tr("PADS");
                for pad in root.setup.pads: PadOfSetup {
                    pad: pad;
                    id-prefix: root.id-prefix;
                }
            }

            Group {
                title: @tr("VIRTUAL PADS");
                for sink in root.setup.sinks: HorizontalLayout {
                    spacing: Design.gap-stack;
                    padding-top: Design.gap-form;
                    padding-bottom: Design.gap-form;
                    Text {
                        width: Design.width-label-col + 20px;
                        text: sink.name;
                        color: Theme.text-dim;
                        font-size: Design.font-meta;
                        vertical-alignment: center;
                    }
                    Text {
                        text: sink.identity;
                        color: Theme.text;
                        font-size: Design.font-meta;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: sink.node == "" ? @tr("not made") : sink.node;
                        color: Theme.text-dim;
                        font-size: Design.font-meta;
                        font-family: Theme.mono-font;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            if root.setup.nodes.length > 0: Group {
                title: @tr("WHO HAS CONTROL");
                for node in root.setup.nodes: NodeOfSetup {
                    setup: root.setup.name;
                    id-prefix: root.id-prefix;
                    node: node;
                    enabled: root.daemon-available;
                }
            }
        }
    }
}

export component SetupsPane {
    in property <bool> daemon-available;
    in property <bool> daemon-loading;
    in property <ServiceHealth> daemon-health;

    property <string> pending-stop: "";

    property <int> focus-detail-tick;
    property <int> column-mirror: Nav.column-tick;
    changed column-mirror => {
        if (Nav.column-target == 2 && root.has-selection) {
            Nav.column-served = Nav.column-tick;
            root.focus-detail-tick += 1;
        }
    }
    property <bool> has-selection: Setups.selected-index >= 0 && Setups.selected-index < Setups.rows.length;
    changed has-selection => {
        if (!root.has-selection && Nav.column == 2) {
            Nav.request-column(1);
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;

        if Errors.setups.title != "" || Errors.setups.message != "": Rectangle {
            background: Theme.surface-alt;
            HorizontalLayout {
                width: 100%;
                padding: 12px;
                padding-bottom: 0;
                InlineError {
                    tone: Errors.setups.tone == "" ? "error" : Errors.setups.tone;
                    title: Errors.setups.title;
                    message: Errors.setups.message;
                    dismissed => {
                        Errors.setups = { kind: "", tone: "", title: "", message: "", action-label: "" };
                    }
                }
            }
        }

        HorizontalLayout {
            width: 100%;
            vertical-stretch: 1;

            SetupList {
                daemon-available: root.daemon-available;
                daemon-loading: root.daemon-loading;
                daemon-health: root.daemon-health;
                activated => { root.focus-detail-tick += 1; }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: Theme.surface-alt;

                if !root.has-selection: VerticalLayout {
                    alignment: center;
                    spacing: Design.gap-stack;
                    Text {
                        text: Setups.rows.length == 0
                            ? @tr("A setup is a profile that is running: its pads become its virtual pads.")
                            : @tr("Pick a setup to see its pads and steer it.");
                        color: Theme.text-faint;
                        font-size: Design.font-body;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if Setups.rows.length == 0: HorizontalLayout {
                        alignment: center;
                        LinkText {
                            column: 2;
                            text: @tr("Start one from Profiles");
                            font-size: Design.font-body;
                            accessible-id: "setups-to-profiles";
                            clicked => { Setups.open-profile(""); }
                        }
                    }
                }

                for setup[i] in Setups.rows: SetupDetail {
                    width: parent.width;
                    height: parent.height;
                    visible: i == Setups.selected-index;
                    setup: setup;
                    daemon-available: root.daemon-available;
                    focus-tick: root.focus-detail-tick;
                    request-stop => { root.pending-stop = setup.name; }
                }
            }
        }
    }

    ConfirmDialog {
        open: root.pending-stop != "";
        title: @tr("Stop setup");
        message: @tr("Stop '{}'? A game using its virtual pad sees the pad disconnect, and the real pads are shown again.", root.pending-stop);
        confirm-label: @tr("Stop");
        confirmed => {
            Setups.stop(root.pending-stop);
            root.pending-stop = "";
        }
        cancelled => {
            root.pending-stop = "";
        }
    }

    ConfirmDialog {
        open: Setups.pending-update != "";
        title: @tr("Update setup");
        message: Setups.pending-update-cost == "restart"
            ? @tr("Updating '{}' to its profile restarts it: a game sees its virtual pad disconnect and another connect.", Setups.pending-update)
            : @tr("Updating '{}' to its profile is applied as it runs: a game notices nothing.", Setups.pending-update);
        confirm-label: Setups.pending-update-cost == "restart" ? @tr("Restart") : @tr("Update");
        confirmed => {
            Setups.update(Setups.pending-update);
            Setups.pending-update = "";
        }
        cancelled => {
            Setups.pending-update = "";
        }
    }
}

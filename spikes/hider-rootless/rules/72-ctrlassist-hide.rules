# A pad the hiding service has hidden: its nodes go to the service's group
# alone and lose seat access. Which pads are hidden is the set of marker
# files under /run/ctrlassist/hide, so this file never changes and udev is
# never asked to reload it. A marker takes effect on the pad's next add or
# change event.
#
# It must sort after 70-uaccess.rules, which tags pads for seat access (and
# after any 60-*.rules that opens hidraw, as Steam's does), and before
# 73-seat-late.rules, which grants the access the tag asks for.
#
# Marker names are flat, with a prefix: an attribute that is empty, or
# carries "/" or "..", then names a file that doesn't exist.
ACTION=="remove", GOTO="ctrlassist_hide_end"
SUBSYSTEM=="hidraw", GOTO="ctrlassist_hide_hidraw"
SUBSYSTEM!="input", GOTO="ctrlassist_hide_end"
KERNEL!="event*|js*", GOTO="ctrlassist_hide_end"

# Event and js nodes: by the pad's address, by its USB serial number, or by
# its model alone. The attributes are the input device's, the parent the
# ATTRS match selected.
ATTRS{uniq}=="?*", TEST=="/run/ctrlassist/hide/addr-%s{uniq}", GOTO="ctrlassist_hide"
ENV{ID_SERIAL_SHORT}=="?*", ATTRS{id/vendor}=="?*", TEST=="/run/ctrlassist/hide/serial-%s{id/vendor}-%s{id/product}-$env{ID_SERIAL_SHORT}", GOTO="ctrlassist_hide"
ATTRS{id/vendor}=="?*", TEST=="/run/ctrlassist/hide/model-%s{id/vendor}-%s{id/product}", GOTO="ctrlassist_hide"
GOTO="ctrlassist_hide_end"

# Hidraw nodes have no address of their own: it is a property of their HID
# device, which the kernel puts in that device's uevent.
LABEL="ctrlassist_hide_hidraw"
# The raw node of a pad the service may open unhidden, for the DualSense
# identity's copy: the group's, beside whatever seat access it has.
DRIVERS=="playstation", GROUP="ctrlassist-hider", MODE="0660"
IMPORT{parent}="HID_UNIQ"
IMPORT{parent}="HID_ID"
ENV{HID_UNIQ}=="?*", TEST=="/run/ctrlassist/hide/addr-$env{HID_UNIQ}", GOTO="ctrlassist_hide"
ENV{HID_ID}=="?*", TEST=="/run/ctrlassist/hide/hid-$env{HID_ID}", GOTO="ctrlassist_hide"
GOTO="ctrlassist_hide_end"

LABEL="ctrlassist_hide"
GROUP="ctrlassist-hider", MODE="0660", TAG-="uaccess"
# A node recreated by a re-bind has no ACL. One that is only changed keeps
# the seat user's, which nothing else takes away: the uaccess builtin runs
# only for nodes that still have the tag.
RUN+="@acl@/bin/setfacl -b $devnode"
LABEL="ctrlassist_hide_end"
